#!/bin/bash
set -euo pipefail

hf="/opt/homebrew/opt/omlx/libexec/bin/hf"
py="/opt/homebrew/opt/omlx/libexec/bin/python3"
models_dir="$HOME/.omlx/models"
# Sibling of models/, never inside it: fetches land here and are moved into place
# only once whole, so a half-finished model is never visible to omlx or to prune.
staging="$HOME/.omlx/.staging"
settings="$HOME/.omlx/model_settings.json"
# Provenance of a finished model dir, so a source or quant-flag change re-fetches
# instead of silently keeping the old weights under the same served id.
stamp=".chezmoi-source"

# Inlined rather than read from .chezmoidata at runtime: chezmoi re-runs this
# script when its rendered content changes, so inlining is what makes a manifest
# edit the trigger.
manifest="$(
	cat <<'MANIFEST'
{{- $entries := list -}}
{{- range .omlx.models -}}
{{-   $dir := index . "dir" | default (splitList "/" .repo | first) -}}
{{-   $entries = append $entries (dict
        "id" .id
        "path" (printf "%s/%s" $dir .id)
        "repo" .repo
        "revision" (index . "revision" | default "")
        "convert" (index . "convert" | default dict)
        "settings" (merge (dict) (index . "settings" | default dict) (dict "is_pinned" false "is_hidden" false "is_default" false))) -}}
{{- end }}
{{ $entries | toPrettyJson }}
MANIFEST
)"

# Validated before anything is fetched or pruned: a bad file must not abort the
# run half-reconciled, and both merge_settings and the baseline would otherwise
# fail alike on it, compare equal on their empty output, and skip the merge
# silently.
if [ ! -f "$settings" ]; then
	echo '{}' >"$settings"
elif ! jq -e . "$settings" >/dev/null 2>&1; then
	echo "$settings is not valid JSON — refusing to merge model settings into it" >&2
	exit 1
fi

# A sharded model lists every weight file in its index; an interrupted fetch can
# leave config.json, a tokenizer and *some* shards, which the file tests alone
# would accept.
shards_present() {
	idx="$1/model.safetensors.index.json"
	[ -f "$idx" ] || return 0
	jq -r '.weight_map | values[]' "$idx" | sort -u | while IFS= read -r f; do
		[ -f "$1/$f" ] || exit 1
	done
}

changed=0

# '|'-joined, not tab-joined: tab is IFS whitespace, so read would collapse a
# download-only entry's empty quant fields into the wrong variables.
while IFS='|' read -r id path repo rev bits group; do
	target="$models_dir/$path"
	if [ -n "$bits" ]; then
		want="convert $repo q$bits g$group"
	elif [ -n "$rev" ]; then
		want="download $repo@$rev"
	else
		want="download $repo"
	fi

	# mlx_lm writes weights, then config.json, then the tokenizer, so config.json
	# alone would bless a conversion that died halfway. Dirs predating the stamp
	# are adopted only if they also carry what gets written last.
	if [ -f "$target/config.json" ]; then
		if [ -f "$target/$stamp" ]; then
			[ "$(cat "$target/$stamp")" = "$want" ] && continue
		elif [ -f "$target/tokenizer_config.json" ] && ls "$target"/*.safetensors >/dev/null 2>&1 &&
			shards_present "$target"; then
			printf '%s\n' "$want" >"$target/$stamp"
			continue
		fi
	fi

	# CI only asserts the source: the runner's Metal VM times out inside the
	# conversion (fresh run 2026-09-08) and has no use for the weights. Prune
	# and the settings merge below still run, so the rest of the script stays
	# covered.
	if [ "${CI:-}" = true ]; then
		api="https://huggingface.co/api/models/$repo"
		[ -z "$rev" ] || api="$api/revision/$rev"
		files="$(curl -fsS "$api" | jq -r '.siblings[].rfilename')"
		if ! grep -qx config.json <<<"$files" || ! grep -q '\.safetensors$' <<<"$files"; then
			echo "omlx source $repo is missing or carries no safetensors weights" >&2
			exit 1
		fi
		echo "omlx source ok: $repo"
		continue
	fi

	tmp="$staging/$id"
	mkdir -p "$staging"
	if [ -n "$bits" ]; then
		echo "Converting omlx model $id from ${repo}…"
		rm -rf "$tmp" # mlx_lm refuses an existing path, and keeps no resume state
		# mlx_lm 0.31.3 (omlx 0.6.4) fetches only weight/config patterns, then
		# re-opens the repo with local_files_only=True, and huggingface_hub >= 1.x
		# refuses the incomplete snapshot (IncompleteSnapshotError). A full fetch
		# first makes the cached snapshot whole; convert then reads from cache.
		# Fixed on mlx-lm main — drop when omlx ships it.
		"$hf" download "$repo"
		"$py" -m mlx_lm convert --hf-path "$repo" \
			-q --q-bits "$bits" --q-group-size "$group" \
			--mlx-path "$tmp"
		printf '%s\n' "$want" >"$tmp/$stamp"
		# reclaim the source weights pulled into the shared HF cache during conversion
		rm -rf "$HOME/.cache/huggingface/hub/models--${repo//\//--}"
	else
		echo "Downloading omlx model $id from ${repo}…"
		# hf leaves in place any file a previous fetch put here, so only a staged dir
		# of matching provenance may be resumed into; anything else is discarded.
		[ "$(cat "$tmp/$stamp" 2>/dev/null || true)" = "$want" ] || rm -rf "$tmp"
		mkdir -p "$tmp"
		printf '%s\n' "$want" >"$tmp/$stamp"
		"$hf" download "$repo" ${rev:+--revision "$rev"} --local-dir "$tmp" # no pre-clean: hf resumes from .cache
		rm -rf "$tmp/.cache"
	fi
	# Swap only once the fetch is whole: a failure above leaves the previous model
	# serving, and the partial work in staging for the next run to resume.
	mkdir -p "$(dirname "$target")"
	[ -d "$target" ] && mv "$target" "$tmp.rollback"
	mv "$tmp" "$target"
	rm -rf "$tmp.rollback"
	changed=1
done < <(jq -r '.[] | [.id, .path, .repo, .revision, (.convert.bits // "" | tostring), (.convert.group_size // "" | tostring)] | join("|")' <<<"$manifest")

keep="$(jq -r '.[].path' <<<"$manifest")"
if [ -z "$keep" ]; then
	echo "omlx manifest is empty — refusing to prune every model" >&2
	exit 1
fi

if [ -d "$models_dir" ]; then
	# Depth bounds mirror omlx's own scan (<models_dir>/<leaf> or
	# <models_dir>/<owner>/<leaf>); unbounded, a config.json nested inside a kept
	# model would nominate that subdirectory for rm -rf.
	# NUL-delimited: a newline in a directory name would otherwise split across
	# two reads and hand a truncated path to rm -rf.
	while IFS= read -r -d '' cfg; do
		dir="$(dirname "$cfg")"
		rel="${dir#"$models_dir"/}"
		# herestring, not a pipe: grep -q's early exit SIGPIPEs the writer, which
		# under pipefail makes the pipeline exit 141 and the match look like a miss.
		grep -qxF "$rel" <<<"$keep" && continue
		echo "Removing omlx model not in the manifest: $rel"
		rm -rf "$dir"
		changed=1
	done < <(find "$models_dir" -mindepth 2 -maxdepth 3 -type f -name config.json -print0)
	find "$models_dir" -mindepth 1 -type d -empty -delete
fi

if [ -d "$staging" ]; then
	ids="$(jq -r '.[].id' <<<"$manifest")"
	for d in "$staging"/*; do
		[ -d "$d" ] || continue
		grep -qxF "${d##*/}" <<<"$ids" && continue
		echo "Discarding abandoned omlx fetch: ${d##*/}"
		rm -rf "$d"
	done
	rmdir "$staging" 2>/dev/null || true
fi

model_settings="$(jq -c 'map({(.id): .settings}) | add' <<<"$manifest")"

# Recursively merge each listed model's settings into the server-owned file, so
# nested keys (chat_template_kwargs set from the admin UI) and every other key
# it wrote (max_context_window, temperature, …) survive. Entries for models no
# longer listed are kept but lose is_default: oMLX serves the first is_default
# in file order and only dedups it through the admin UI.
merge_settings() {
	jq --argjson want "$model_settings" '
		.version = (.version // 1)
		| .models = ((.models // {})
			| with_entries(if $want[.key] then . else .value.is_default = false end)
			| reduce ($want | to_entries[]) as $e (.;
				.[$e.key] = ((.[$e.key] // {}) * $e.value)))
	' "$settings"
}

[ "$(merge_settings)" = "$(jq . "$settings")" ] || changed=1

[ "$changed" -eq 1 ] || exit 0

# omlx registers models only at startup and rewrites model_settings.json from the
# copy it loaded then, so the settings are merged with the service down. Fetching
# above ran with it up: a multi-gigabyte download shouldn't take autocomplete
# offline for the duration.
brew services stop omlx
trap 'brew services start omlx' EXIT # a merge failure must not leave autocomplete offline
# Same-directory temp then rename: a truncating write that died partway would
# hand the restarting server an empty settings file.
merge_settings >"$settings.new"
mv "$settings.new" "$settings"
