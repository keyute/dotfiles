{{- $apiKey := onepasswordRead "op://Personal/oMLX/password" -}}
{
  "server": {
    "port": 11434,
    {{- /* an empty list makes omlx detect aliases at start and rewrite this file */}}
    "server_aliases": [
      "localhost",
      "127.0.0.1"
    ]
  },
  "cache": {
    "hot_cache_max_size": "4GB"
  },
  "auth": {
    {{- /* admin login password; /admin/chat injects it, and admin login is refused while it is null */}}
    "api_key": {{ $apiKey | toJson }},
    {{- /* signs admin session cookies: derived from the key, since anything guessable lets a login be forged */}}
    "secret_key": {{ list $apiKey "omlx-session" | join "|" | sha256sum | toJson }},
    {{- /* /v1 inference stays keyless for minuet's dummy key; admin, status and load/unload still need the key */}}
    "allow_unauthenticated_inference": true
  }
}
