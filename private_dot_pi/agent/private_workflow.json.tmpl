{{- $pi := .agents.pi -}}
{{- $sandbox := includeTemplate "agent-sandbox" (dict "self" "pi" "root" .) | fromJson -}}
{{- $agentDir := printf "%s/.pi/agent" .chezmoi.homeDir -}}
{{- $denyRead := $sandbox.denyRead | uniq | sortAlpha -}}
{{- /* Only live-loaded code is write-protected: the shared node_modules deny
       plus the applied agent dir and the shell init that launches pi. Repo
       source is fair game, as for the other harnesses; chezmoi apply is the gate. */ -}}
{{- $denyWrite := concat $sandbox.denyWrite (list $agentDir (printf "%s/.zshrc" .chezmoi.homeDir)) -}}
{{- /* bash 3.2 here-documents land in /var/tmp (docs/decisions.md, parity.pi_sandbox_paths) */ -}}
{{- $allowWrite := append $sandbox.allowWrite "/var/tmp" -}}
{{- $mcp := includeTemplate "mcp-servers" (dict "root" . "harness" "pi") | fromJson -}}
{{- /* MCP servers run inside SRT here, so each server's own hosts join the allowlist */ -}}
{{- $domains := .agent_sandbox.network.allowed_domains -}}
{{- range $mcp -}}{{- $domains = concat $domains .policy.domains -}}{{- end -}}
{{- $domains = $domains | uniq | sortAlpha -}}
{{- $roles := includeTemplate "pi-roles" (dict "root" .) | fromJson -}}
{{- $cls := $pi.defaults.classifier -}}
{{- $clsModel := get .subagent_tiers.pi $cls.tier -}}
{{- if not $clsModel -}}{{- fail (printf "classifier: unknown tier %s" $cls.tier) -}}{{- end -}}
{{- $searchModel := get .subagent_tiers.pi $pi.search_tier -}}
{{- if not $searchModel -}}{{- fail (printf "agents.pi.search_tier: unknown tier %s" $pi.search_tier) -}}{{- end -}}
{{- dict
      "version" 1
      "agentDir" $agentDir
      "childLimit" $pi.child_limit
      "models" (dict
          "provider" $pi.defaults.provider
          "classifierFilter" (dict "model" $clsModel "reasoningEffort" $cls.filter_effort)
          "classifierJudge" (dict "model" $clsModel "reasoningEffort" $cls.judge_effort)
          "search" $searchModel
          "tiers" .subagent_tiers.pi)
      "filesystem" (dict
          "denyRead" $denyRead
          "denyWrite" $denyWrite
          "allowWrite" $allowWrite)
      "network" (dict "allowedDomains" $domains "allowLocalBinding" .agent_sandbox.network.allow_local_binding)
      "agents" $roles
      "mcp" $mcp | toPrettyJson -}}
