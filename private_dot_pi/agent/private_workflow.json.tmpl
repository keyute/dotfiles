{{- $pi := .agents.pi -}}
{{- $sandbox := includeTemplate "agent-sandbox" (dict "self" "pi" "root" .) | fromJson -}}
{{- $agentDir := printf "%s/.pi/agent" .chezmoi.homeDir -}}
{{- $source := .chezmoi.sourceDir -}}
{{- $denyRead := concat $sandbox.denyRead (list (printf "%s/workflow.json" $agentDir)) | uniq | sortAlpha -}}
{{- /* Only live-loaded code is write-protected: the applied agent dir, the
       shell init that launches pi, and the pinned node_modules the running CLI
       and its children import from. Repo source is fair game, as for the other
       harnesses; chezmoi apply is the gate. */ -}}
{{- $denyWrite := list
      $agentDir
      (printf "%s/.zshrc" .chezmoi.homeDir)
      (printf "%s/node_modules" $source) -}}
{{- $domains := concat .agent_sandbox.network.allowed_domains $pi.extras.allowed_domains (list "api.exa.ai") | uniq | sortAlpha -}}
{{- $mcp := includeTemplate "mcp-servers" (dict "root" . "harness" "pi") | fromJson -}}
{{- $roles := includeTemplate "pi-roles" (dict "root" .) | fromJson -}}
{{- dict
      "version" 1
      "agentDir" $agentDir
      "models" (dict
          "provider" $pi.defaults.provider
          "default" $pi.defaults.model
          "classifier" $pi.defaults.classifier_model
          "classifierEffort" $pi.defaults.classifier_reasoning_effort
          "defaultEffort" $pi.defaults.reasoning_effort
          "planEffort" $pi.defaults.plan_reasoning_effort
          "tiers" .subagent_tiers.pi)
      "filesystem" (dict
          "denyRead" $denyRead
          "denyWrite" $denyWrite
          "allowWrite" $sandbox.allowWrite)
      "network" (dict "allowedDomains" $domains)
      "agents" $roles
      "mcp" $mcp | toPrettyJson -}}
