{{- $pi := .agents.pi -}}
{{- $enabledModels := list -}}
{{- range $model := .subagent_tiers.pi -}}
  {{- $enabledModels = append $enabledModels (printf "%s/%s" $pi.defaults.provider $model) -}}
{{- end -}}
{{- $managed := dict
      "defaultProvider" $pi.defaults.provider
      "defaultModel" (index .subagent_tiers.pi $pi.defaults.tier)
      "defaultThinkingLevel" $pi.defaults.reasoning_effort
      "enabledModels" ($enabledModels | uniq | sortAlpha)
      "fullscreenExitOutput" "resume-hint"
      "quietStartup" true
      "hideThinkingBlock" false
      "terminal" (dict "showImages" false)
      "outputPad" 0
      "theme" "catppuccin-latte/catppuccin-mocha"
      "themes" (list (printf "%s/node_modules/catppuccin-pi-theme/themes" .chezmoi.sourceDir))
      "shellPath" "/bin/zsh"
      "shellCommandPrefix" "source ~/.zshrc"
      "subagents" (dict
          "disableBuiltins" true
          "defaultProvider" $pi.defaults.provider) -}}
#!/usr/bin/env bash
# pi's settings setters write UI state (theme, thinking level, changelog version)
# to settings.json; jq's `*` keeps whatever this declared subset does not name
# (theme and thinking level are managed, so they reset on apply; objects merge
# recursively, arrays and scalars are replaced).
set -euo pipefail

input=$(cat)
[ -z "$input" ] && input='{}'

printf '%s\n' "$input" | jq --argjson managed '{{ $managed | toJson }}' '. * $managed'
