{{- $pi := .agents.pi -}}
{{- $enabledModels := list -}}
{{- range $model := .subagent_tiers.pi -}}
  {{- $enabledModels = append $enabledModels (printf "%s/%s" $pi.defaults.provider $model) -}}
{{- end -}}
{{- $managed := dict
      "defaultProvider" $pi.defaults.provider
      "defaultModel" (index .subagent_tiers.pi $pi.defaults.tier)
      "defaultThinkingLevel" $pi.defaults.reasoning_effort
      "theme" "catppuccin-latte/catppuccin-mocha"
      "themes" (list (printf "%s/node_modules/catppuccin-pi-theme/themes" .chezmoi.sourceDir)) -}}
{{- /* startup selection and model cycling offer only the pi tiers */ -}}
{{- $_ := set $managed "enabledModels" ($enabledModels | uniq | sortAlpha) -}}
{{- /* fullscreen TUI enables mouse input (click-to-expand tool rows) */ -}}
{{- $_ := set $managed "tuiMode" "fullscreen" -}}
{{- /* fullscreen exit prints a resume hint, not the whole transcript */ -}}
{{- $_ := set $managed "fullscreenExitOutput" "resume-hint" -}}
{{- /* hides pi's startup key hints, model scope and resource listing; header.mjs draws the session header */ -}}
{{- $_ := set $managed "quietStartup" true -}}
{{- /* no inline images in the terminal; shows turn progress in the terminal tab */ -}}
{{- $_ := set $managed "terminal" (dict "showImages" false "showTerminalProgress" true) -}}
{{- /* no horizontal transcript padding */ -}}
{{- $_ := set $managed "outputPad" 0 -}}
{{- /* drops the subagent extension's built-in agents; the roster is the whole set */ -}}
{{- $_ := set $managed "subagents" (dict "disableBuiltins" true) -}}
{{- /* turns off pi's install ping to pi.dev */ -}}
{{- $_ := set $managed "enableInstallTelemetry" false -}}
{{- /* shows a condensed changelog after an update */ -}}
{{- $_ := set $managed "collapseChangelog" true -}}
{{- /* delivers queued steering and follow-up messages together, not one per turn */ -}}
{{- $_ := set $managed "steeringMode" "all" -}}
{{- $_ := set $managed "followUpMode" "all" -}}
#!/usr/bin/env bash
# pi's settings setters write UI state (theme, thinking level, changelog version)
# to settings.json; jq's `*` (sprig mergeOverwrite would drop false/0) keeps what
# this declared subset does not name (theme and thinking level are managed, so
# they reset on apply; objects merge recursively, arrays and scalars are replaced).
# modelThinkingLevels is deleted: per-model overrides outrank defaultThinkingLevel.
set -euo pipefail

input=$(cat)
[ -z "$input" ] && input='{}'

printf '%s\n' "$input" | jq --argjson managed '{{ $managed | toJson }}' '. * $managed | del(.modelThinkingLevels)'
