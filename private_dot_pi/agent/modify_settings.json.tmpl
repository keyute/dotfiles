{{- $pi := .agents.pi -}}
{{- $enabledModels := list -}}
{{- range $model := .subagent_tiers.pi -}}
  {{- $enabledModels = append $enabledModels (printf "%s/%s" $pi.defaults.provider $model) -}}
{{- end -}}
{{- $managed := dict
      "defaultProvider" $pi.defaults.provider
      "defaultModel" (index .subagent_tiers.pi $pi.defaults.tier)
      "defaultThinkingLevel" $pi.defaults.reasoning_effort
      "enabledModels" ($enabledModels | uniq | sortAlpha)
      "theme" "catppuccin-latte/catppuccin-mocha"
      "themes" (list (printf "%s/node_modules/catppuccin-pi-theme/themes" .chezmoi.sourceDir)) -}}
{{- /* fullscreen exit prints a resume hint, not the whole transcript */ -}}
{{- $_ := set $managed "fullscreenExitOutput" "resume-hint" -}}
{{- /* hides the startup header */ -}}
{{- $_ := set $managed "quietStartup" true -}}
{{- /* no inline images in the terminal */ -}}
{{- $_ := set $managed "terminal" (dict "showImages" false) -}}
{{- /* no horizontal transcript padding */ -}}
{{- $_ := set $managed "outputPad" 0 -}}
{{- /* ! commands run in zsh with the interactive config */ -}}
{{- $_ := set $managed "shellPath" "/bin/zsh" -}}
{{- $_ := set $managed "shellCommandPrefix" "source ~/.zshrc" -}}
{{- /* drops the subagent extension's built-in agents; the roster is the whole set */ -}}
{{- $_ := set $managed "subagents" (dict "disableBuiltins" true "defaultProvider" $pi.defaults.provider) -}}
{{- /* keeps thinking blocks shown even after pi's UI toggle persists hide */ -}}
{{- $_ := set $managed "hideThinkingBlock" false -}}
{{- /* turns off pi's install ping to pi.dev */ -}}
{{- $_ := set $managed "enableInstallTelemetry" false -}}
#!/usr/bin/env bash
# pi's settings setters write UI state (theme, thinking level, changelog version)
# to settings.json; jq's `*` keeps whatever this declared subset does not name
# (theme and thinking level are managed, so they reset on apply; objects merge
# recursively, arrays and scalars are replaced).
set -euo pipefail

input=$(cat)
[ -z "$input" ] && input='{}'

printf '%s\n' "$input" | jq --argjson managed '{{ $managed | toJson }}' '. * $managed'
