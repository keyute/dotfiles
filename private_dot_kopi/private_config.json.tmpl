{{- $sb := includeTemplate "agent-sandbox" (dict "self" "kopi" "root" .) | fromJson -}}
{{- /* both ask by default */ -}}
{{- $allow := list "WebFetch" "WebSearch" -}}
{{- /* the sandbox covers only Bash, and kopi denies no credential path outside its
       own home: each path the sandbox denies is denied to every file tool too */ -}}
{{- $deny := list -}}
{{- range $sb.denyRead -}}{{- $deny = append $deny (printf "*(%s)" .) -}}{{- end -}}
{{- /* allows are per tool, so a tool a server adds later keeps review; a bare
       deny removes the tool from the model */ -}}
{{- range $name, $cfg := .agent_mcp_servers -}}
  {{- range default (list) (get $cfg "denied_tools") -}}{{- $deny = append $deny (printf "mcp__%s__%s" $name .) -}}{{- end -}}
  {{- range default (list) (get $cfg "auto_approve") -}}{{- $allow = append $allow (printf "mcp__%s__%s" $name .) -}}{{- end -}}
{{- end -}}
{{- $servers := includeTemplate "mcp-servers" (dict "root" .) | fromJson -}}
{
  "version": 1,
  {{- /* driver pin from agents.yaml */}}
  "model": {{ .subagent_tiers.kopi.top | toJson }},
  {{- /* answers WebFetch and WebSearch; unset, they run on the session model */}}
  "smallModel": {{ .subagent_tiers.kopi.small | toJson }},
  {{- /* left: the default plus the plan windows, where Claude's statusline.sh shows
         them; right: the default without `sandbox` (enabled below, it never changes) */}}
  "statusline": {
    "left": ["$model", "$context", "(ses $limit_5h( $reset_5h))", "(wk $limit_wk( $reset_wk))", "$branch( $changes)"],
    "right": ["$notice", "$shells", "$ultracode", "$mode"]
  },
  "permissions": {
    "allow": {{ $allow | toPrettyJson | indent 4 | trim }},
    "deny": {{ $deny | toPrettyJson | indent 4 | trim }}
  },
  {{- /* with it on, an Edit or Write no rule matches runs without asking;
       the calls still left asking (MCP tools with no allow rule, `unsandboxed` Bash calls) are reviewed on the session model */}}
  "classifier": {
    "enabled": true
  },
  {{- /* Bash runs in the OS sandbox; refuse to start without it */}}
  "sandbox": {
    "enabled": true,
    {{- /* hosts sandboxed Bash may reach through kopi's proxy; none otherwise */}}
    "allowDomains": {{ .agent_sandbox.network.allowed_domains | toPrettyJson | indent 4 | trim }},
    "allowWrite": {{ $sb.allowWrite | toPrettyJson | indent 4 | trim }},
    {{- /* plain paths, no globs: a relative name covers only <start dir>/name */}}
    "denyRead": {{ $sb.denyRead | toPrettyJson | indent 4 | trim }}
  },
  {{- /* op secrets resolve at apply, into this private file only */}}
  "mcpServers": {{ $servers | toPrettyJson | indent 2 | trim }}
}
