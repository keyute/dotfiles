if [[ $SHLVL -eq 1 ]]; then
  printf '\n%.0s' {1..$LINES}
fi

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

alias python='python3'
alias lg='lazygit'
alias lzd='lazydocker'
alias lsql='lazysql'
# pi ships no permission system; the srt wrapper is its only boundary — never
# launch the bare binary (settings rendered from .chezmoidata/agents.yaml)
alias pi='srt --settings ~/.pi/srt-settings.json pi'

# `gh` handles both hosts (auto-detects host from a repo's remote). `ghe` forces the
# GHES host for repo-independent commands and for gh-dash (`ghe dash`).
ghe() { GH_HOST=git.kubecity.com gh "$@"; }

if type brew &>/dev/null; then
    FPATH="$(brew --prefix)/share/zsh/site-functions:$(brew --prefix)/share/zsh-completions:$FPATH"
fi

# User completions (e.g. _docker generated from the docker CLI; see run_onchange_after_docker-completion)
FPATH="$HOME/.local/share/zsh/site-functions:$FPATH"

zmodload zsh/complist
autoload -U compinit; compinit
_comp_options+=(globdots)

# uv keeps each project's venv in-tree at .venv. Activate the nearest one on cd and
# drop it on the way out. The walk stops at the nearest project root, not the nearest
# .venv: a nested project without an env yet must not inherit its parent's Python.
# Panes/multiplexers (herdr) can inherit VIRTUAL_ENV without the activate script's
# functions, so tear down by hand when `deactivate` is missing.
_venv_autoswitch() {
  emulate -L zsh
  local dir=${PWD:A} venv=""
  while true; do
    if [[ -f $dir/.venv/bin/activate ]]; then venv=$dir/.venv; break; fi
    [[ -f $dir/pyproject.toml || $dir == ($HOME|/) ]] && break
    dir=$dir:h
  done

  # An inherited env carries no deactivate function; fall through to re-source it.
  [[ ${VIRTUAL_ENV:A} == $venv ]] && (( $+functions[deactivate] )) && return

  if [[ -n $VIRTUAL_ENV ]]; then
    if (( $+functions[deactivate] )); then
      deactivate
    else
      path=("${(@)path:#${VIRTUAL_ENV}/bin}")
      unset VIRTUAL_ENV VIRTUAL_ENV_PROMPT
    fi
  fi

  # p10k owns the prompt; keep activate from prepending "(project) " to PS1.
  local VIRTUAL_ENV_DISABLE_PROMPT=1
  [[ -n $venv ]] && source $venv/bin/activate
}
autoload -Uz add-zsh-hook
add-zsh-hook chpwd _venv_autoswitch
_venv_autoswitch

source $HOME/.local/share/antidote/antidote.zsh
antidote load

zstyle ':completion:complete:git-*:argument-rest' sort false

typeset -g _APPEARANCE=""
_sync_appearance() {
    local mode=$(theme-mode 2>/dev/null || echo dark)
    [[ $mode == $_APPEARANCE ]] && return
    _APPEARANCE=$mode
    export LC_THEME_MODE=$mode

    # One canonical flavor per mode; every Catppuccin-themed tool derives its var
    # from it, so adding a tool below is a single line.
    local flavor Flavor
    if [[ $mode == light ]]; then flavor=latte; Flavor=Latte
    else                          flavor=mocha; Flavor=Mocha
    fi
    export BAT_THEME="Catppuccin $Flavor"
    export K9S_SKIN="catppuccin-$flavor"
    export GH_DASH_CONFIG="$HOME/.config/gh-dash/config.catppuccin-$flavor.yml"
    export ENHANCE_THEME="catppuccin_$flavor"

    # fzf-tab isn't Catppuccin-named, so it stays an explicit mode toggle.
    if [[ $mode == light ]]; then
        zstyle ':fzf-tab:*' default-color $'\033[30m'
        zstyle ':fzf-tab:*' fzf-flags --color=light
    else
        zstyle -d ':fzf-tab:*' default-color
        zstyle -d ':fzf-tab:*' fzf-flags
    fi
}
autoload -Uz add-zsh-hook
add-zsh-hook precmd _sync_appearance

# Repo basenames repeat across orgs (backend, infrastructure, ...) and worktree
# names across repos, so herdr's auto-labels collide in the sidebar. Feed the
# $org/$repo tokens in ui.sidebar.spaces/agents.rows (config.toml); a shell hook
# is herdr's documented reporter for cwd-derived tokens — no server-side event
# fires on cd. Space rows read workspace metadata, Agent rows read pane
# metadata: separate namespaces. Workspace org is reported for top-level repos
# but cleared for worktree workspaces (the parent Space row already carries it)
# and left untouched outside ~/Projects — sibling panes visiting $HOME must not
# wipe workspace identity. Pane tokens have a single writer (this shell) and
# mirror honestly: org wherever derivable, repo only in worktrees — elsewhere
# the entry title is already the repo. No cache/--seq/--ttl: identical
# re-reports are harmless patches and let a restarted server self-heal on the
# next cd. Backgrounded so cd never blocks on the socket.
_herdr_report_org() {
  emulate -L zsh
  # bg_nice's setpriority can fail loudly (and pointlessly) in restricted envs.
  setopt local_options no_bg_nice
  [[ ${HERDR_ENV:-} == 1 && -n ${HERDR_WORKSPACE_ID:-} && -n ${HERDR_PANE_ID:-} ]] || return 0
  local root=${PWD:A} org="" repo="" wt=0
  # Linked worktrees live under ~/.herdr; resolve to the main repo. Ordinary
  # cds stay pure-zsh — no git spawn.
  if [[ $root == $HOME/.herdr/worktrees/* ]]; then
    wt=1
    root=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
    root=${root%/.git}
    repo=${root:t}
  fi
  case $root in
    $HOME/Projects/work/*) org=${${root#$HOME/Projects/work/}%%/*} ;;
    $HOME/Projects/*)      org=${${root#$HOME/Projects/}%%/*} ;;
  esac
  {
    if (( wt )); then
      herdr workspace report-metadata "$HERDR_WORKSPACE_ID" --source zsh-org --clear-token org
    elif [[ -n $org ]]; then
      herdr workspace report-metadata "$HERDR_WORKSPACE_ID" --source zsh-org --token org="$org"
    fi
    if [[ -n $org ]]; then
      herdr pane report-metadata "$HERDR_PANE_ID" --source zsh-org --token org="$org"
    else
      herdr pane report-metadata "$HERDR_PANE_ID" --source zsh-org --clear-token org
    fi
    if [[ -n $repo ]]; then
      herdr pane report-metadata "$HERDR_PANE_ID" --source zsh-org --token repo="$repo"
    else
      herdr pane report-metadata "$HERDR_PANE_ID" --source zsh-org --clear-token repo
    fi
  } &>/dev/null &!
}
add-zsh-hook chpwd _herdr_report_org
_herdr_report_org

eval "$(zoxide init zsh --cmd cd)"

# Pin the emacs keymap: zsh picks viins whenever EDITOR/VISUAL contains "vi"
# at zle init, so shells that inherit EDITOR=nvim from a parent env (herdr/tmux
# server panes) silently lose ^A/^E. Must precede the bindkey calls below —
# switching keymaps resets main.
bindkey -e
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[[1~' beginning-of-line
bindkey '^[[4~' end-of-line
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down

export PATH="$PATH:$HOME/.local/bin"
{{- if eq .chezmoi.os "linux" }}
export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"
{{- end }}

export GOPRIVATE="git.keyute.io"
export GOPATH="$HOME/.go"
export PATH="$GOPATH/bin:$PATH"

export XDG_CONFIG_HOME="$HOME/.config"

alias vim=nvim
alias vi=nvim
alias cat='bat --paging=never'
export EDITOR="nvim"

export HISTFILE="$HOME/.zhistory"
export HISTSIZE=1000000000
export SAVEHIST=1000000000
setopt SHARE_HISTORY
setopt INC_APPEND_HISTORY
setopt HIST_IGNORE_ALL_DUPS

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
