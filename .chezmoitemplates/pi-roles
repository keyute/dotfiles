{{- /* pi-roles: render the shared role definitions as Pi's child contracts.
       input: dict "root" <template data>
       output: JSON map keyed by Pi role name */ -}}
{{- $root := .root -}}
{{- $agentDir := printf "%s/.pi/agent" $root.chezmoi.homeDir -}}
{{- $roles := dict -}}
{{- range $name, $meta := $root.subagents -}}
  {{- /* Explore and explorer are the same shared role; Pi has only explorer. */ -}}
  {{- if ne $name "Explore" -}}
    {{- $tools := list -}}
    {{- $needsMcp := false -}}
    {{- range splitList "," $meta.tools -}}
      {{- $sourceTool := trim . -}}
      {{- if eq $sourceTool "Read" -}}{{- $tools = append $tools "workspace_read" -}}
      {{- else if eq $sourceTool "Grep" -}}{{- $tools = append $tools "workspace_grep" -}}
      {{- else if eq $sourceTool "Glob" -}}{{- $tools = concat $tools (list "workspace_find" "workspace_ls") -}}
      {{- else if eq $sourceTool "Bash" -}}{{- $tools = concat $tools (list "workspace_bash" "workspace_task") -}}
      {{- else if eq $sourceTool "Edit" -}}{{- $tools = append $tools "workspace_edit" -}}
      {{- else if eq $sourceTool "Write" -}}{{- $tools = append $tools "workspace_write" -}}
      {{- else if eq $sourceTool "WebSearch" -}}{{- $tools = append $tools "web_search" -}}
      {{- end -}}
      {{- /* Exa fetch stays behind the MCP proxy, as WebFetch's counterpart */ -}}
      {{- if or (eq $sourceTool "WebFetch") (hasPrefix "mcp__" $sourceTool) -}}
        {{- $needsMcp = true -}}
      {{- end -}}
    {{- end -}}
    {{- if $needsMcp -}}{{- $tools = append $tools "mcp" -}}{{- end -}}
    {{- $nests := default false (get $meta "nests") -}}
    {{- if $nests -}}{{- $tools = concat $tools (list "subagent" "bg_wait") -}}{{- end -}}
    {{- /* `inherit` is pi-subagents' frontmatter value for the parent's model */ -}}
    {{- $model := "inherit" -}}
    {{- if ne $meta.tier "inherit" -}}
      {{- $model = printf "%s/%s" $root.agents.pi.defaults.provider (index $root.subagent_tiers.pi $meta.tier) -}}
    {{- end -}}
    {{- /* mutationTools: renamed tools are invisible to pi-subagents' long-running guard and mutation evidence, so mutation-capable roles declare them; the shell and (for nesting roles) subagent are listed too because only the literal `bash` name gets command inspection upstream, and an untracked file created by a shell command or a delegated child leaves no other evidence */ -}}
    {{- $mutationTools := list -}}
    {{- if not $meta.readonly -}}
      {{- range $tools -}}
        {{- if or (eq . "workspace_bash") (eq . "workspace_edit") (eq . "workspace_write") (eq . "subagent") -}}{{- $mutationTools = append $mutationTools . -}}{{- end -}}
      {{- end -}}
    {{- end -}}
    {{- $role := dict
          "readonly" $meta.readonly
          "nests" $nests
          "tools" ($tools | uniq)
          "mutationTools" ($mutationTools | uniq)
          "model" $model
          "thinking" $meta.reasoning_effort
          "extensionPath" (printf "%s/policy-roles/%s.ts" $agentDir $name)
          "agentPath" (printf "%s/agents/%s.md" $agentDir $name) -}}
    {{- $roles = set $roles $name $role -}}
  {{- end -}}
{{- end -}}
{{- $roles | toJson -}}
