{{- /* agent-sandbox: resolve the agnostic sandbox filesystem policy for one agent.
       input:  dict "self" <agent name> "root" <template data>
       output: JSON {denyRead, allowWrite, denyWrite}; denyWrite is the repo's
       node_modules, live code both harnesses run outside their sandboxes */ -}}
{{- $self := .self -}}
{{- $root := .root -}}
{{- $denyRead := list -}}
{{- $allowWrite := list -}}
{{- $fs := $root.agent_sandbox.filesystem -}}
{{- range $path, $mode := $fs.paths -}}
  {{- if eq $mode "none" -}}
    {{- $denyRead = append $denyRead $path -}}
  {{- else if eq $mode "write" -}}{{- $allowWrite = append $allowWrite $path -}}
  {{- end -}}
{{- end -}}
{{- range $name, $agent := $root.agents -}}
  {{- if ne $name $self -}}
    {{- $denyRead = append $denyRead $agent.home -}}
  {{- else -}}
    {{- /* the agent's own home is denied only at its sensitive subpaths, so
           features living under home (e.g. projects/<proj>/memory) keep working */ -}}
    {{- range $agent.sensitive_subpaths -}}
      {{- $denyRead = append $denyRead (printf "%s/%s" $agent.home .) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- dict "denyRead" $denyRead "allowWrite" $allowWrite "denyWrite" (list (printf "%s/node_modules" $root.chezmoi.sourceDir)) | toJson -}}
