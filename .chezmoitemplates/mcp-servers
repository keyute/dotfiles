{{- /* mcp-servers: resolve agent_mcp_servers into concrete server entries for one
       harness. Skips entries scoped to other harnesses (`harnesses` list) and
       entries whose `requires` binary is absent from PATH.
       input:  dict "root" (the root template data) "harness" ("claude"|"codex")
               ["policyOnly" true]
       output: JSON {name: {connection: {...}, policy: {...}}}
                 connection: {type: "http", url} | {type: "stdio", command, args, env}
                             — op: refs resolved via onepasswordRead, command
                             defaulting to node_modules/.bin/<package_bin>
                 policy:     {auto_approve_tools, denied_tools} — always both keys,
                             normalized to false/[] so consumers can index them
                             unguarded
       policyOnly omits `connection` entirely (and resolves no secrets), so a
       caller that must not depend on 1Password can still reuse this filter. It
       omits rather than emitting connection with unresolved refs on purpose: a
       credential-stripped server object looks usable and would be written as a
       broken config, whereas a missing one fails loudly. */ -}}
{{- $root := .root -}}
{{- $harness := .harness -}}
{{- /* get, not .policyOnly: chezmoi renders with missingkey=error */ -}}
{{- $policyOnly := get . "policyOnly" -}}
{{- $out := dict -}}
{{- range $name, $cfg := $root.agent_mcp_servers -}}
  {{- $harnesses := get $cfg "harnesses" -}}
  {{- if and $harnesses (not (has $harness $harnesses)) -}}
    {{- continue -}}
  {{- end -}}
  {{- $requires := get $cfg "requires" -}}
  {{- if and $requires (not (lookPath $requires)) -}}
    {{- continue -}}
  {{- end -}}
  {{- $entry := dict "policy" (dict
        "auto_approve_tools" (default false (get $cfg "auto_approve_tools"))
        "denied_tools" (default (list) (get $cfg "denied_tools"))) -}}
  {{- if not $policyOnly -}}
    {{- $connection := dict -}}
    {{- $url := get $cfg "url" -}}
    {{- if $url -}}
      {{- $connection = dict "type" "http" "url" $url -}}
    {{- else -}}
      {{- $command := get $cfg "command" -}}
      {{- if not $command -}}
        {{- $command = printf "%s/node_modules/.bin/%s" $root.chezmoi.sourceDir $cfg.package_bin -}}
      {{- end -}}
      {{- $args := list -}}
      {{- range $cfg.args -}}
        {{- if kindIs "map" . -}}
          {{- $ref := .op -}}
          {{- if not (hasPrefix "op://" $ref) -}}
            {{- $ref = printf "op://%s" $ref -}}
          {{- end -}}
          {{- $args = append $args (onepasswordRead $ref) -}}
        {{- else -}}
          {{- $args = append $args . -}}
        {{- end -}}
      {{- end -}}
      {{- $env := dict -}}
      {{- range $key, $value := default (dict) (get $cfg "env") -}}
        {{- if kindIs "map" $value -}}
          {{- $ref := $value.op -}}
          {{- if not (hasPrefix "op://" $ref) -}}
            {{- $ref = printf "op://%s" $ref -}}
          {{- end -}}
          {{- $env = set $env $key (onepasswordRead $ref) -}}
        {{- else -}}
          {{- $env = set $env $key $value -}}
        {{- end -}}
      {{- end -}}
      {{- $connection = dict "type" "stdio" "command" $command "args" $args "env" $env -}}
    {{- end -}}
    {{- $entry = set $entry "connection" $connection -}}
  {{- end -}}
  {{- $out = set $out $name $entry -}}
{{- end -}}
{{- $out | toJson -}}
