{{- /* mcp-servers: resolve agent_mcp_servers into concrete connection entries.
       input: dict "root" (the root template data)
       output: JSON {name: connection}
                 http:  {type, url, headers}, Authorization being "Bearer " + the
                        bearer_op ref resolved via onepasswordRead
                 stdio: {type, command, args}, a leading `~/` in args expands to home
       Every caller resolves 1Password; a template that must render without it
       reads the policy keys (auto_approve, denied_tools) from the data instead. */ -}}
{{- $root := .root -}}
{{- $out := dict -}}
{{- range $name, $cfg := $root.agent_mcp_servers -}}
  {{- if hasKey $cfg "url" -}}
    {{- $bearer := printf "Bearer %s" (onepasswordRead (printf "op://%s" $cfg.bearer_op)) -}}
    {{- $out = set $out $name (dict "type" "http" "url" $cfg.url "headers" (dict "Authorization" $bearer)) -}}
  {{- else -}}
    {{- $args := list -}}
    {{- range $cfg.args -}}
      {{- $args = append $args (regexReplaceAll "^~/" . (printf "%s/" $root.chezmoi.homeDir)) -}}
    {{- end -}}
    {{- $out = set $out $name (dict "type" "stdio" "command" $cfg.command "args" $args) -}}
  {{- end -}}
{{- end -}}
{{- $out | toJson -}}
