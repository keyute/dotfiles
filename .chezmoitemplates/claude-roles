{{- /* claude-roles: resolve the shared role definitions to Claude Code pins.
       input: dict "root" <template data>
       output: JSON map keyed by role name to model and effort; roles scoped to
       other harnesses are omitted */ -}}
{{- $root := .root -}}
{{- $roles := dict -}}
{{- range $name, $meta := $root.subagents -}}
  {{- $harnesses := get $meta "harnesses" -}}
  {{- $scoped := true -}}
  {{- if $harnesses -}}{{- if not (has "claude" $harnesses) -}}{{- $scoped = false -}}{{- end -}}{{- end -}}
  {{- if $scoped -}}
    {{- $tier := get $meta "tier" -}}
    {{- $model := get $root.subagent_tiers.claude $tier -}}
    {{- if not $model -}}{{- fail (printf "%s: unknown tier %s" $name $tier) -}}{{- end -}}
    {{- $effort := get $meta "effort" -}}
    {{- if not $effort -}}{{- fail (printf "%s: missing effort" $name) -}}{{- end -}}
    {{- $roles = set $roles $name (dict "model" $model "effort" $effort) -}}
  {{- end -}}
{{- end -}}
{{- $roles | toJson -}}
