#!/usr/bin/env node
// PreToolUse hook on the Agent tool: no child runs the frontier tier — it is
// the driver's tier alone (CLAUDE.md frontier_driver). CLAUDE_CODE_SUBAGENT_MODEL
// only sets the default for unpinned children; a per-call `model` still wins,
// which is the path this hook closes. Rendered from agents.yaml so the pin
// cannot drift from subagent_tiers.claude.frontier.
// The CLI accepts many frontier spellings (fable, fable-5, fable51,
// claude-fable-5-1, claude-fable-5-mythos-5, ...), so the match is by family
// prefix, not the exact pin; `inherit` resolves to the parent, i.e. the
// frontier driver, so it is denied too. Forks (`subagent_type: fork`) always
// run the parent model by harness design and carry no `model`; they are a
// driver-context continuation, not a worker, and pass through here.
const FRONTIER_FAMILY = /^(claude-)?(fable|mythos)/;
const PIN = {{ .subagent_tiers.claude.frontier | toJson }};
if (!FRONTIER_FAMILY.test(PIN)) throw new Error(`frontier pin ${PIN} is outside the family this hook denies`);

let input = "";
for await (const chunk of process.stdin) input += chunk;
const model = JSON.parse(input).tool_input?.model;
if (typeof model !== "string") process.exit(0);
// `[1m]` selects the 1M-context variant of the same model
const requested = model.replace(/\[1m\]$/, "");
if (!FRONTIER_FAMILY.test(requested) && requested !== "inherit") process.exit(0);
process.stdout.write(JSON.stringify({
  hookSpecificOutput: {
    hookEventName: "PreToolUse",
    permissionDecision: "deny",
    permissionDecisionReason: `Children never run the frontier tier (${model}); dispatch it at its pinned tier or the top worker tier, or do the piece yourself.`,
  },
}));
