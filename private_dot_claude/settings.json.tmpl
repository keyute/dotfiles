{{- $sb := fromJson (includeTemplate "agent-sandbox" (dict "self" "claude" "root" .)) -}}
{{- $allowedDomains := concat .agent_sandbox.network.allowed_domains .agents.claude.extras.allowed_domains -}}
{{- $allowedPerms := list "WebSearch" "WebFetch" -}}
{{- $modelSettings := dict -}}
{{- $noEffort := default (list) (get .agents.claude "no_effort_models") -}}
{{- range $tier, $pin := .subagent_tiers.claude -}}
  {{- if not (has $pin $noEffort) -}}
    {{- $_ := set $modelSettings $pin (dict "effortLevel" $.agents.claude.defaults.reasoning_effort) -}}
  {{- end -}}
{{- end -}}
{{- /* the frontier pin's Agent-tool alias is its family segment (claude-<family>-…),
       so the deny follows the pin; denied_tools hand-lists only aliases with no tier */}}
{{- $permDeny := append .agents.claude.denied_tools (printf "Agent(model:%s)" (index (splitList "-" .subagent_tiers.claude.frontier) 1)) -}}
{{- /* The harness merges Read()/Edit() denies into the Bash sandbox's deny
       lists. Relative names also get Edit() because they fall inside the
       writable cwd. Restore sandbox.filesystem.* if a release stops merging. */ -}}
{{- range $sb.denyRead -}}
  {{- $permDeny = append $permDeny (printf "Read(%s)" .) -}}
  {{- if not (or (hasPrefix "~" .) (hasPrefix "/" .)) -}}{{- $permDeny = append $permDeny (printf "Edit(%s)" .) -}}{{- end -}}
{{- end -}}
{{- /* policyOnly: the servers themselves are rendered into ~/.claude.json, and
       resolving their op secrets here would make settings.json depend on
       1Password. An auto-approved server gets a per-tool allow for each of its
       readonly_tools only, so a tool it adds later keeps normal review;
       denied_tools are denied outright. */ -}}
{{- range $name, $entry := includeTemplate "mcp-servers" (dict "root" . "harness" "claude" "policyOnly" true) | fromJson -}}
  {{- range $entry.policy.denied_tools -}}
    {{- $permDeny = append $permDeny (printf "mcp__%s__%s" $name .) -}}
  {{- end -}}
  {{- if $entry.policy.auto_approve_tools -}}
    {{- range $entry.policy.readonly_tools -}}
      {{- $allowedPerms = append $allowedPerms (printf "mcp__%s__%s" $name .) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{
  "permissions": {
    "allow": {{ $allowedPerms | toPrettyJson | indent 4 | trim }},
    "deny": {{ $permDeny | toPrettyJson | indent 4 | trim }},
    {{- /* sessions start in plan mode, not auto */}}
    "defaultMode": "plan",
    {{- /* no --dangerously-skip-permissions or bypass mode */}}
    "disableBypassPermissionsMode": "disable"
  },
  {{- /* driver pin from agents.yaml */}}
  "model": {{ (index .subagent_tiers.claude .agents.claude.defaults.tier) | toJson }},
  {{- /* every Claude pin that takes an effort knob gets the driver effort, so a
         /model change keeps it */}}
  "modelSettings": {{ $modelSettings | toPrettyJson | indent 2 | trim }},
  {{- /* fallback for the built-in `claude` type, plugin and workflow agents; a default, not a
         force — leave CLAUDE_CODE_SUBAGENT_MODEL_FORCE unset, it would erase specialist pins */}}
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": {{ .subagent_tiers.claude.top | toJson }},
    {{- /* also disables the bundled `loop` skill; add `loop: "off"` to skill_overrides if this goes */}}
    "CLAUDE_CODE_DISABLE_CRON": "1",
    {{- /* no Statsig telemetry and no feature-flag fetching (local-only) */}}
    "DISABLE_TELEMETRY": "1",
    {{- /* no Sentry error reports */}}
    "DISABLE_ERROR_REPORTING": "1",
    {{- /* --add-dir directories also load their CLAUDE.md files, as pi does */}}
    "CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD": "1",
    {{- /* stdio MCP servers get only an allowlisted env, not the full shell env */}}
    "CLAUDE_CODE_MCP_ALLOWLIST_ENV": "1",
    {{- /* a subagent's subagent cannot spawn another (main is depth 0), matching pi's maxSubagentDepth */}}
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2"
  },
  {{- /* Mirrors herdr's canonical SessionStart entry (structural JSON equality)
         so `herdr integration install claude` leaves this file untouched; the
         script itself is herdr-generated and chezmoi-unmanaged. */}}
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  {{- /* no Remote Control bridge to claude.ai or the mobile app */}}
  "disableRemoteControl": true,
  {{- /* ccstatusline, and the model row for subagents */}}
  "statusLine": {
    "type": "command",
    "command": "{{ .chezmoi.sourceDir }}/node_modules/.bin/ccstatusline"
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "{{ .chezmoi.homeDir }}/.claude/subagent-statusline.js"
  },
  {{- /* plugin set from agents.yaml */}}
  "enabledPlugins": {{ .agents.claude.plugins | toPrettyJson | indent 2 | trim }},
  {{- /* Bash runs in the OS sandbox; refuse to start without it */}}
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "network": {
      "allowedDomains": {{ $allowedDomains | uniq | toPrettyJson | indent 6 | trim }},
      "allowLocalBinding": {{ .agent_sandbox.network.allow_local_binding }}
    },
    "filesystem": {
      "allowWrite": {{ $sb.allowWrite | toPrettyJson | indent 6 | trim }},
      "denyWrite": {{ $sb.denyWrite | toPrettyJson | indent 6 | trim }}
    }
  },
  {{- /* no rotating tips under the spinner */}}
  "spinnerTipsEnabled": false,
  {{- /* no session recap on returning after 5+ minutes away */}}
  "awaySummaryEnabled": false,
  {{- /* no built-in commit/PR workflow instructions in the system prompt */}}
  "includeGitInstructions": false,
  {{- /* no greyed-out next-prompt suggestions */}}
  "promptSuggestionEnabled": false,
  {{- /* no agent view: `claude agents`, --bg, /background and the on-demand daemon */}}
  "disableAgentView": true,
  {{- /* alternate-screen TUI, as pi's managed launch */}}
  "tui": "fullscreen",
  {{- /* advisory fan-out size the Workflow tool shows the driver */}}
  "workflowSizeGuideline": "small",
  {{- /* Internal one-time consent flag for the auto-mode workflow prompt; the
         CLI writes it into this chezmoi-owned file, so without it every apply
         brings the prompt back. */}}
  "skipWorkflowUsageWarning": true,
  {{- /* follow the terminal's light/dark mode */}}
  "theme": "auto",
  {{- /* no claude-cli:// URL handler registered with the OS */}}
  "disableDeepLinkRegistration": "disable",
  {{- /* no claude.ai account surface */}}
  "enableArtifact": false,
  "disableClaudeAiConnectors": true,
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  {{- /* bundled-skill listing from agents.yaml */}}
  "skillOverrides": {{ .agents.claude.skill_overrides | toPrettyJson | indent 2 | trim }}
}
