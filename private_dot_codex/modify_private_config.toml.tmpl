{{- $codex := .agents.codex -}}
{{- $sandbox := includeTemplate "agent-sandbox" (dict "self" "codex" "root" .) | fromJson -}}
{{- $filesystem := dict -}}
{{- $workspaceFilesystem := dict -}}
{{- /* deny uses $sandbox.denyRead (not sandboxDenyRead) on purpose: this single
       permission profile is Codex's only file-access gate, so it must carry the
       UNION of what claude splits across its OS sandbox (sandboxDenyRead) and its
       Read-tool deny (full denyRead) — i.e. Codex's own home-sensitive paths too.
       Codex reads its own auth.json/config.toml outside the sandbox, so denying
       them to tools is the intended guard. Do not switch this to sandboxDenyRead;
       that would let Codex tools read their own credentials and weaken parity. */ -}}
{{- $modeGroups := list
      (dict "mode" "write" "paths" $sandbox.allowWrite)
      (dict "mode" "read" "paths" $sandbox.allowRead)
      (dict "mode" "deny" "paths" $sandbox.denyRead) -}}
{{- range $group := $modeGroups -}}
  {{- range $path := $group.paths -}}
    {{- $expanded := $path -}}
    {{- if hasPrefix "~/" $expanded -}}
      {{- $expanded = printf "%s/%s" $.chezmoi.homeDir (trimPrefix "~/" $expanded) -}}
    {{- end -}}
    {{- if hasPrefix "/" $expanded -}}
      {{- $_ := set $filesystem $expanded $group.mode -}}
    {{- else -}}
      {{- $_ := set $workspaceFilesystem $expanded $group.mode -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- $fsTable := $filesystem -}}
{{- if $workspaceFilesystem -}}
  {{- $fsTable = set $fsTable ":workspace_roots" $workspaceFilesystem -}}
{{- end -}}
{{- $domainsTable := dict -}}
{{- range concat .agent_sandbox.network.allowed_domains $codex.extras.allowed_domains | uniq | sortAlpha -}}
  {{- $domainsTable = set $domainsTable . "allow" -}}
{{- end -}}
{{- $deletes := list
      "model"
      "model_reasoning_effort"
      "plan_mode_reasoning_effort"
      "review_model"
      "agents.default_subagent_model"
      "approval_policy"
      "approvals_reviewer"
      "default_permissions"
      "features.network_proxy"
      "features.apps"
      "features.remote_plugin"
      "features.multi_agent_v2"
      "apps._default.enabled"
      "mcp_servers.codex_app"
      "permissions.chezmoi-workspace"
      "notice.hide_rate_limit_model_nudge" -}}
{{- /* mcp_servers.codex_app: Codex Desktop persists a transport-less
       `enabled_tools` override for its own app MCP server into this shared file,
       and a stanza with no command/url makes the CLI abort every config load with
       "invalid transport in `mcp_servers.codex_app`" (openai/codex#40860, verified
       reproducible on 0.154.0). Delete-only, no managed counterpart: Desktop can
       re-add it at runtime, apply just sweeps it back out. */ -}}
{{- $mcpServers := dict -}}
{{- range $name, $entry := includeTemplate "mcp-servers" (dict "root" . "harness" "codex") | fromJson -}}
  {{- if not (regexMatch "^[A-Za-z0-9_-]+$" $name) -}}
    {{- fail (printf "Codex MCP server name %q must be a bare TOML key (it is used in a dotted delete path)" $name) -}}
  {{- end -}}
  {{- $deletes = append $deletes (printf "mcp_servers.%s" $name) -}}
  {{- $conn := $entry.connection -}}
  {{- $server := dict -}}
  {{- if eq $conn.type "http" -}}
    {{- $server = dict "url" $conn.url -}}
  {{- else -}}
    {{- $server = dict "command" $conn.command "args" $conn.args -}}
    {{- if $conn.env -}}
      {{- $server = set $server "env" $conn.env -}}
    {{- end -}}
  {{- end -}}
  {{- /* translate the contract's shared policy section into Codex's dialect:
         omitting default_tools_approval_mode leaves Codex's normal review in
         place, and disabled_tools subtracts individual tools from a server that
         is otherwise auto-approved. */ -}}
  {{- if $entry.policy.auto_approve_tools -}}
    {{- $server = set $server "default_tools_approval_mode" "approve" -}}
  {{- end -}}
  {{- if $entry.policy.denied_tools -}}
    {{- $server = set $server "disabled_tools" $entry.policy.denied_tools -}}
  {{- end -}}
  {{- $mcpServers = set $mcpServers $name $server -}}
{{- end -}}
{{- /* The Codex desktop app writes its own skills.config entries (that is where
       browser:control-in-app-browser comes from), so chezmoi cannot own the array
       via delete+managed — it overrides individual entries by name and leaves the
       rest alone. Consequence: an override has no delete counterpart, so dropping a
       skill here leaves its last value in ~/.codex/config.toml; flip it back in
       the Codex GUI, which owns the entry anyway. */ -}}
{{- $skillConfig := list -}}
{{- range $skill, $enabled := default (dict) (get $codex "skills") -}}
  {{- $skillConfig = append $skillConfig (dict "name" $skill "enabled" $enabled) -}}
{{- end -}}
{{- /* tui is fully managed for cross-machine TUI consistency: status_line and
       status_line_use_colors are re-emitted via managed below, while tui.theme is
       deleted and deliberately NOT re-emitted (managed-to-absence) so every
       machine runs Codex's default theme detection and none can drift. */ -}}
{{- $deletes = concat $deletes (list "tui.status_line" "tui.status_line_use_colors" "tui.theme") -}}
{{- /* features.hooks: herdr's codex integration sets it; owning it here keeps
       apply from wiping it. ~/.codex/hooks.json stays herdr-managed. */ -}}
{{- /* features.apps: a ChatGPT-authenticated Codex registers a reserved
       `codex_apps` MCP server proxying the account's Apps (Connectors), and
       features.remote_plugin pulls the ChatGPT-hosted plugin catalog; both off so
       the tool surface is only what agent_mcp_servers declares. apps._default is a
       second gate on the same capability because OpenAI has renamed the first one
       once already (enable_mcp_apps -> features.apps), and a rename reads as
       default-on. Only its _default.enabled leaf is claimed: apps.<id>.* is
       Desktop-GUI-owned, like skills.config. */ -}}
{{- /* features.multi_agent_v2: wait_agent returns the moment a child finishes, so
       the 5-minute floor costs nothing and only stops short-timer polling, which
       re-reads the root context on every wake-up (audit log 2026-09-21). The whole
       key is owned, enabled included: 0.154.0 defaults it off, and a table without
       `enabled` replacing a boolean `true` would switch the feature off. Drop the
       floor once openai/codex#46120 lets a finished child wake an idle parent, or
       if a stalled child makes a 5-minute block hurt. */ -}}
{{- /* notice: the rest of that table is Codex runtime state (dismissals,
       model_migrations, migration-prompt timestamps), so only the one leaf that
       suppresses the near-usage-limit model-switch nudge is claimed here. */ -}}
{{- /* review_model and agents.default_subagent_model: the driver is the
       frontier tier, review and unpinned children are worker roles (see the
       codex defaults comment in agents.yaml). */ -}}
{{- $managed := dict
      "model" $codex.defaults.model
      "model_reasoning_effort" $codex.defaults.model_reasoning_effort
      "plan_mode_reasoning_effort" $codex.defaults.plan_mode_reasoning_effort
      "review_model" .subagent_tiers.codex.top
      "agents" (dict "default_subagent_model" .subagent_tiers.codex.top)
      "approval_policy" "on-request"
      "approvals_reviewer" "auto_review"
      "default_permissions" "chezmoi-workspace"
      "features" (dict
          "network_proxy" (dict "enabled" true)
          "hooks" true
          "apps" false
          "remote_plugin" false
          "multi_agent_v2" (dict
              "enabled" true
              "min_wait_timeout_ms" 300000
              "default_wait_timeout_ms" 300000))
      "apps" (dict "_default" (dict "enabled" false))
      "permissions" (dict "chezmoi-workspace" (dict
          "description" "Workspace writes with shared sensitive-path and network controls"
          "extends" ":workspace"
          "filesystem" $fsTable
          "network" (dict
              "enabled" true
              "mode" "limited"
              "allow_local_binding" .agent_sandbox.network.allow_local_binding
              "domains" $domainsTable)))
      "mcp_servers" $mcpServers
      "tui" (dict
          "status_line" (list "model-with-reasoning" "context-used" "five-hour-limit" "weekly-limit" "git-branch" "branch-changes")
          "status_line_use_colors" true)
      "notice" (dict "hide_rate_limit_model_nudge" true) -}}
{{- $manifest := dict "delete" $deletes "managed" $managed "skill_config" $skillConfig -}}
#!/usr/bin/env bash
# Partial management of ~/.codex/config.toml: the merge script replaces the keys
# chezmoi owns (listed in the manifest's delete/managed entries) and preserves
# everything else Codex writes at runtime (trusted projects, notices, ...).
set -euo pipefail

{
  cat <<'CHEZMOI_MANIFEST_JSON'
{{ $manifest | toJson }}
CHEZMOI_MANIFEST_JSON
  cat
} | node "{{ .chezmoi.sourceDir }}/scripts/merge-codex-config.mjs"
