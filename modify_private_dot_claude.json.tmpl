#!/usr/bin/env bash
set -euo pipefail

input=$(cat)
[ -z "$input" ] && input='{}'

servers=$(cat <<'CHEZMOI_MCP_JSON'
{{ includeTemplate "mcp-servers" (dict "root" . "harness" "claude") }}
CHEZMOI_MCP_JSON
)

# .connection only: the shared template also carries a `policy` section, which is
# projected into permissions by settings.json.tmpl and must not reach this file
printf '%s\n' "$input" | jq -j --argjson servers "$servers" \
  '.mcpServers = ($servers | map_values(.connection))'
